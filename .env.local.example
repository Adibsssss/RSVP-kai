# --- Google OAuth, acting as a real Google account you control ---
# Same pattern as event-gallery's Drive setup, but scoped to Sheets.
# Run `node scripts/get-refresh-token.js` after setting the client id/secret
# below to generate GOOGLE_OAUTH_REFRESH_TOKEN.

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=1oNNQFKYKKys6fTplI23C4gYQxEvf781_78Vk0ApRjA0

# Optional — defaults to "RSVP". Must match an actual sheet/tab name.
GOOGLE_SHEET_NAME=RSVP
# This app supports the supplied RSVP.xlsx: headers are on row 5 and records
# begin at row 6. A Message column is added at D5 when the first RSVP arrives.
